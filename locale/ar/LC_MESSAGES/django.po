msgid ""
"<p>Dear {{ recipient_name }},</p><p>Booking <strong>{{ "
"booking.voucher_number }}</strong> with {{ agency.name }} has been "
"cancelled.</p>"
msgstr ""
"<p>عزيزي {{ recipient_name }}،</p><p>تم إلغاء الحجز <strong>{{ "
"booking.voucher_number }}</strong> مع {{ agency.name }}.</p>"

msgid ""
"<p>Dear {{ recipient_name }},</p><p>We've received a payment of <strong>{{ "
"payment.amount }}</strong> ({{ payment.get_payment_method_display }}) for "
"booking {{ booking.voucher_number }}.</p><p>Thank you.</p>"
msgstr ""
"<p>عزيزي {{ recipient_name }}،</p><p>لقد استلمنا دفعة بقيمة <strong>{{ "
"payment.amount }}</strong> ({{ payment.get_payment_method_display }}) للحجز "
"{{ booking.voucher_number }}.</p><p>شكرًا لك.</p>"

msgid ""
"<p>Dear {{ recipient_name }},</p><p>Your booking <strong>{{ "
"booking.voucher_number }}</strong> with {{ agency.name }} has been "
"confirmed.</p><p>Travelers: {{ mutamer_names }}<br>Total: {{ "
"booking.total_amount }}</p><p>Thank you for booking with us.</p>"
msgstr ""
"<p>عزيزي {{ recipient_name }}،</p><p>تم تأكيد حجزك <strong>{{ "
"booking.voucher_number }}</strong> مع {{ agency.name }}.</p><p>المسافرون: {{"
" mutamer_names }}<br>الإجمالي: {{ booking.total_amount }}</p><p>شكرًا لحجزك "
"معنا.</p>"

msgid ""
"<p>Dear {{ recipient_name }},</p><p>Your voucher for booking <strong>{{ "
"booking.voucher_number }}</strong> is ready. Your agent can share the "
"printable copy with you.</p>"
msgstr ""
"<p>عزيزي {{ recipient_name }}،</p><p>قسيمتك للحجز <strong>{{ "
"booking.voucher_number }}</strong> جاهزة. يمكن لوكيلك مشاركة النسخة القابلة "
"للطباعة معك.</p>"

