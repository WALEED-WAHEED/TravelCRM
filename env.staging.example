# Staging environment — copy to .env.staging (gitignored) and fill in.
# Used by: docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# Staging is meant to mirror production configuration (DEBUG off, secure
# cookies, HSTS) against a separate database and separate host ports so it
# can run alongside local dev on the same machine — see
# docker-compose.staging.yml for the defaults this fills in.

DJANGO_SECRET_KEY=generate-a-real-random-secret-do-not-reuse-prod-or-dev
ALLOWED_HOSTS=staging.yourdomain.com
FRONTEND_URL=https://staging.yourdomain.com
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://staging.yourdomain.com

# Postgres admin credentials (superuser — runs migrations, owns the
# schema). Not the same role the app connects as day-to-day.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=set-a-real-password-here

# The app's own runtime connection — the scoped, non-superuser role
# (auto-created on first boot by scripts/init-scoped-role.sql; set its
# password to match this value, and grant it table/sequence access after
# the first `migrate` — see scripts/README.md).
DB_NAME=travelcrm_staging
DB_USER=travelcrm_app
DB_PASSWORD=set-a-different-real-password-here

# Email — point at a real (or sandboxed, e.g. Mailtrap) SMTP provider;
# leaving EMAIL_BACKEND as the console backend means staging "sends"
# email to container logs only, which is fine for early smoke-testing
# but won't catch real deliverability issues.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@staging.yourdomain.com

# Error monitoring (Phase 11) — optional; leave blank to run without it.
# Get a DSN from https://sentry.io (or a self-hosted instance) once you
# have an account — see travelcrm/settings.py for how this is wired up.
SENTRY_DSN=
