# Production Environment Variables for Travel CRM
# Copy this file to .env and update the values

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-production-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# Database Configuration (PostgreSQL)
POSTGRES_DB=travelcrm_prod
POSTGRES_USER=travelcrm_user
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email Configuration (for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (for QR codes and CORS)
FRONTEND_URL=https://yourdomain.com

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Static and Media Files (for production with CDN)
STATIC_URL=https://yourdomain.com/static/
MEDIA_URL=https://yourdomain.com/media/

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/travelcrm/django.log

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/1

# Celery (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
