# Production Environment Variables for Travel CRM
# Copy this file to .env and update the values

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-production-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# Database Configuration (PostgreSQL)
# These names must match what settings.py reads (DB_*, not POSTGRES_*) and
# what docker-compose.yml passes to the web container.
DB_NAME=travelcrm_prod
DB_USER=travelcrm_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# Second connection to the same database as a scoped, non-superuser role
# (created outside migrations — see scripts/README.md) — Row-Level Security
# only takes effect for connections that are neither the table owner nor a
# superuser, so this must NOT be the same role used to run migrations.
# Used by the tenant-isolation test suite (Phase 11) and should match
# DB_USER/DB_PASSWORD above if the app itself already runs as the scoped role.
SCOPED_DB_USER=travelcrm_user
SCOPED_DB_PASSWORD=your-secure-database-password

# Email Configuration (for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (for QR codes)
FRONTEND_URL=https://yourdomain.com

# CORS / CSRF (comma-separated). Required in production — without these,
# CORS_ALLOW_ALL_ORIGINS only turns on automatically when DEBUG=True.
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Static and Media Files (for production with CDN)
STATIC_URL=https://yourdomain.com/static/
MEDIA_URL=https://yourdomain.com/media/

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/travelcrm/django.log

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/1

# Celery (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Assistant (Phase 09)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Voice (Phase 10)
VOICE_PROVIDER=web-speech

# Error monitoring (Phase 11) — optional; leave SENTRY_DSN blank to run
# without it. Get a DSN from https://sentry.io (or a self-hosted instance).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Attendance office-network check: number of reverse proxies in front of the app
# (1 when behind nginx). Leave 0 if the app is reached directly.
ATTENDANCE_TRUSTED_PROXIES=1
