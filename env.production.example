# Production settings for docker-compose.prod.yml — copy to .env.production (gitignored) and fill in:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Everything security-related (DEBUG off, HTTPS redirect, secure cookies, proxy header, app role) is fixed
# in the compose file; only the values below vary per server.

# The domain the app is served on. Its DNS A record must point at this server before the first start,
# so Caddy can get the HTTPS certificate.
DOMAIN=crm.yourdomain.com

# Long random string, unique to this server:
#   python -c "import secrets; print('django-' + secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Database. The admin owns the schema and runs migrations; the app itself connects as the scoped
# travelcrm_app role with DB_PASSWORD (created automatically on the first start). Use two different
# strong passwords, letters and digits only (they are passed through URLs and shell scripts).
DB_NAME=travelcrm
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_PASSWORD=

# Email (SMTP) — e.g. Brevo, Amazon SES or Gmail with an app password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# AI assistant (optional; the assistant is off without a key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Start HSTS short; raise to 31536000 (one year) once HTTPS has worked for a few weeks.
SECURE_HSTS_SECONDS=3600

# Nightly backups (the `backup` service). Dumps are always kept on the server (last 14); with the R2 values
# set, an encrypted copy of each dump and of the uploaded images also goes to Cloudflare R2 (free up to 10 GB).
# R2: create a bucket, then an API token with "Object Read & Write" on that bucket only.
# BACKUP_PASSPHRASE encrypts the copies — store it in a password manager too: without it they cannot be restored.
BACKUP_TIME=21:00
BACKUP_PASSPHRASE=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Error monitoring (optional).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
